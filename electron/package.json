{
  "name": "chronicle-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop window for a Chronicle server",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icon": "node make-icon.mjs",
    "dist": "npm run icon && electron-builder",
    "dist:win": "npm run icon && electron-builder --win",
    "dist:linux": "npm run icon && electron-builder --linux",
    "dist:mac": "npm run icon && electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "de.pocherhome.chronicle",
    "productName": "Chronicle",
    "files": [
      "main.js",
      "preload.js",
      "setup.html",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "mac": {
      "category": "public.app-category.productivity"
    }
  },
  "allowScripts": {
    "electron@39.8.10": true,
    "electron-winstaller@5.4.0": true
  }
}
