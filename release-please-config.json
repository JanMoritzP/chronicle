{
  "packages": {
    ".": {
      "release-type": "node",
      "include-v-in-tag": true,
      "extra-files": [
        { "type": "json", "path": "electron/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "electron/package-lock.json", "jsonpath": "$.version" },
        { "type": "json", "path": "server/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "web/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "package-lock.json", "jsonpath": "$.version" },
        { "type": "json", "path": "package-lock.json", "jsonpath": "$.packages[\"\"].version" },
        { "type": "json", "path": "package-lock.json", "jsonpath": "$.packages[\"server\"].version" },
        { "type": "json", "path": "package-lock.json", "jsonpath": "$.packages[\"web\"].version" }
      ]
    }
  }
}
